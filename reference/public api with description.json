    "/api/upload/uploadTranFile": {
      "post": {
        "tags": [
          "Inbound APIs"
        ],
        "summary": "Upload transaction file",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "SO Demo"
            }
          },
          {
            "name": "fileName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "So Demo.xlsx"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File uploaded successfully"
          }
        }
      }
    },
    "/api/report/getReportData": {
      "post": {
        "tags": [
          "Outbound Report APIs"
        ],
        "summary": "Get Report Data",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "layoutId": {
                    "type": "integer"
                  },
                  "layoutName": {
                    "type": "string"
                  },
                  "entityName": {
                    "type": "string"
                  },
                  "reportId": {
                    "type": "integer"
                  },
                  "reportType": {
                    "type": "integer"
                  },
                  "bookId": {
                    "type": "integer"
                  },
                  "netType": {
                    "type": "integer"
                  },
                  "currencyType": {
                    "type": "integer"
                  },
                  "download": {
                    "type": "boolean"
                  },
                  "periodId": {
                    "type": "integer"
                  },
                  "layoutFields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "fieldConfigId": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string",
                          "nullable": true
                        },
                        "indicator": {
                          "type": "integer",
                          "format": "int32"
                        }
                      }
                    }
                  },
                  "waterFallType": {
                    "type": "integer"
                  },
                  "summarized": {
                    "type": "boolean"
                  }
                },
                "example": {
                  "layoutId": 0,
                  "reportId": 3,
                  "reportType": 1,
                  "bookId": 1,
                  "netType": 1,
                  "currencyType": 0,
                  "download": true,
                  "periodId": 1,
                  "layoutFields": [
                    {
                      "fieldConfigId": 13,
                      "value": "USD",
                      "indicators": 0
                    }
                  ],
                  "waterFallType": 0,
                  "summarized": true
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Report data fetched"
          }
        }
      }
    },
